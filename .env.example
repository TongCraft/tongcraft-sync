# UUID of the initial administrator's genuine Minecraft account; hyphens are optional.
TONGCRAFT_ADMIN_UUID=REPLACE_WITH_OWNER_UUID
# DNS record must point to the deployment host. Keep ports 80 and 443 available.
SYNC_DOMAIN=sync.example.com

# Public address of the TongCraft schematic library.
TONGCRAFT_LIBRARY_URL=https://library.weiuou.top
